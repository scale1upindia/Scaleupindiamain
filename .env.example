# ==============================================================================
# SCALE-UP INDIA — ENTERPRISE ENVIRONMENT CONFIGURATION (.env.example)
# Note: Never commit real credentials or production secrets to source control.
# ==============================================================================

# Core Application Runtime
NODE_ENV=development
PORT=3000

# Authentication & Session Security (Must be at least 32 characters in production)
AUTH_SECRET=8e32fd958c9b56d86a8daad9db557332713c38fb758fb70f959331e4661626d1
SESSION_EXPIRY_DAYS=7

# Google OAuth 2.0 / OpenID Connect Authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Authorized redirect URI in Google Cloud Console:
# https://<domain>/api/v1/auth/google/callback or http://localhost:3000/api/v1/auth/google/callback

# Database Connection (PostgreSQL)
# If left blank, defaults to the high-performance embedded PGlite WASM engine
DATABASE_URL=

# Secure Document Vault & Storage
STORAGE_TYPE=local
STORAGE_DIR=./data/vault

# Payment Gateway Configuration (Phase 11)
# In production, provide live gateway credentials. Never enable test provider in prod.
ENABLE_TEST_PAYMENT_PROVIDER=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email Communication Configuration (Phase 15)
# In production, supply SendGrid / SMTP credentials. Never enable test provider in prod.
ENABLE_TEST_EMAIL_PROVIDER=false
EMAIL_PROVIDER=SENDGRID
EMAIL_API_KEY=
EMAIL_FROM=notifications@scaleupindia.gov.in
EMAIL_WEBHOOK_SECRET=

# Commercial Deal Parameters
DEFAULT_TOKEN_FEE=5000
DEFAULT_FACILITATION_FEE_PCT=2.0
SELLER_RESPONSE_SLA_HOURS=24
